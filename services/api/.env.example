# Copy to .env and fill in.

# Postgres. Locally: the docker-compose database. In production: Supabase > Project Settings > Database > Connection string.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gasolina

# "dev" = sign in by email only, for local testing. Use "supabase" anywhere public.
AUTH_MODE=dev

# Supabase > Project Settings > API > Project URL (needed when AUTH_MODE=supabase)
SUPABASE_URL=
# Only if your Supabase project still uses the legacy JWT secret (Settings > API > JWT secret)
SUPABASE_JWT_SECRET=

# This email becomes an owner on startup so you can sign in the first time
BOOTSTRAP_OWNER_EMAIL=
BOOTSTRAP_OWNER_NAME=Owner

# Where the web app runs (comma-separated)
CORS_ORIGINS=http://localhost:5173
