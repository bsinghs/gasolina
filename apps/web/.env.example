# Copy to .env.local and fill in.

# Where the API lives. Leave empty in development (Vite forwards /api to localhost:8000).
# In production: the API's public URL, e.g. https://gasolina-api.onrender.com
VITE_API_URL=

# "dev" = sign in by typing an email (local testing only). "supabase" = Google / email link.
VITE_AUTH_MODE=dev

# Supabase > Project Settings > API (needed when VITE_AUTH_MODE=supabase)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
